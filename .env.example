# ==============================================================================
# BCIS Subscription Billing and Collection System — Environment Variables Template
# ==============================================================================

# Node Environment
NODE_ENV=development

# Server Network Configuration
API_HOST=0.0.0.0
API_PORT=4000
API_CORS_ORIGIN=*

# PostgreSQL Database Configuration
DATABASE_URL=postgres://bcis_user:bcis_password@localhost:5432/bcis_billing_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bcis_billing_db
DB_USER=bcis_user
DB_PASSWORD=bcis_password
DB_POOL_MIN=2
DB_POOL_MAX=20

# JWT & Authentication Secret
JWT_SECRET=super-secret-bcis-jwt-token-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=8h

# Storage Directories
ATTACHMENTS_DIR=./data/attachments
BACKUPS_DIR=./data/backups

# Client Desktop Configuration (Used by Electron Renderer)
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_APP_TITLE=BCIS Billing & Collection System
