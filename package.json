{
  "name": "bcis-sub-billing-system",
  "version": "1.0.0",
  "private": true,
  "description": "Bukidnon Cable and Internet Services (BCIS) Subscription Billing and Collection System",
  "scripts": {
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "test:unit": "pnpm --filter @bcis/domain test",
    "test:integration": "pnpm --filter @bcis/backend test",
    "test:acceptance": "pnpm --filter @bcis/backend test:acceptance",
    "dev": "pnpm --filter @bcis/backend --filter @bcis/frontend --parallel dev",
    "dev:backend": "pnpm --filter @bcis/backend dev",
    "dev:frontend": "pnpm --filter @bcis/frontend dev",
    "dist:frontend": "pnpm --filter @bcis/frontend run dist",
    "dist:frontend:portable": "pnpm --filter @bcis/frontend run dist:portable",
    "dist:frontend:nsis": "pnpm --filter @bcis/frontend run dist:nsis",
    "db:generate": "pnpm --filter @bcis/backend db:generate",
    "db:push": "pnpm --filter @bcis/backend db:push",
    "db:migrate": "pnpm --filter @bcis/backend db:migrate",
    "db:seed": "pnpm --filter @bcis/backend db:seed"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
